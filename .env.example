# Runtime mode: offline, online, or auto.
DEMO_MODE=offline

# Required only for online mode. Inject this as a server-side secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Local Gradio binding. Use 0.0.0.0 inside a container.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Generated runs are disposable and may contain submitted text.
FIGUREFLOW_OUTPUT_DIR=demo/output
FIGUREFLOW_MAX_RUNS=8

# Public-safe mode ignores custom briefs, forces the synthetic offline replay,
# and disables live API/icon calls.
FIGUREFLOW_PUBLIC_DEMO=false

# Recommended whenever online mode is reachable beyond localhost.
FIGUREFLOW_BASIC_AUTH_USER=
FIGUREFLOW_BASIC_AUTH_PASSWORD=

# Optional explicit host font override. Docker already installs Noto CJK.
FIGUREFLOW_FONT_FAMILY=
